{
  "name": "shush",
  "displayName": "Shush",
  "description": "Opens .env, .dev.vars, and JSON config files with their values redacted, so secrets never flash on screen during calls or screen shares.",
  "version": "0.3.0",
  "publisher": "thedevlabs-io",
  "author": {
    "name": "thedevlabs-io"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/thedevlabs-io/shush",
  "repository": {
    "type": "git",
    "url": "https://github.com/thedevlabs-io/shush.git"
  },
  "bugs": {
    "url": "https://github.com/thedevlabs-io/shush/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "env",
    "secrets",
    "privacy",
    "screen share",
    "dotenv",
    "redact",
    "cloudflare",
    "firebase"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "shush.redactedEditor",
        "displayName": "Redacted (Shush)",
        "selector": [
          {
            "filenamePattern": "**/.env"
          },
          {
            "filenamePattern": "**/.env.*"
          },
          {
            "filenamePattern": "**/*.env"
          },
          {
            "filenamePattern": "**/.dev.vars"
          },
          {
            "filenamePattern": "**/.dev.vars.*"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "shush.protectActiveFile",
        "title": "Shush: Protect this file (add to .shushrc.json)"
      },
      {
        "command": "shush.openConfig",
        "title": "Shush: Open project config (.shushrc.json)"
      },
      {
        "command": "shush.openAsText",
        "title": "Shush: Open active file as plain text"
      },
      {
        "command": "shush.toggleHistory",
        "title": "Shush: Turn version history on or off"
      },
      {
        "command": "shush.clearHistory",
        "title": "Shush: Delete all stored version history"
      }
    ],
    "configuration": {
      "title": "Shush",
      "properties": {
        "shush.patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional glob patterns to redact, on top of the built-in .env / .dev.vars patterns. Committing these to .shushrc.json shares them with your team."
        },
        "shush.history.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Keep a version history of protected files. **Off by default.** Snapshots are taken on save and stored encrypted in your OS credential store — never in the workspace, so they cannot be committed. User-scoped only: a workspace cannot switch this on for you."
        },
        "shush.history.maxVersions": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "scope": "application",
          "description": "How many versions to keep per file. Older versions are discarded."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm test && npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "test": "npm run compile && esbuild src/*.test.ts --bundle --outdir=dist --out-extension:.js=.cjs --platform=node --format=cjs && node --test dist/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.66.0"
  }
}
