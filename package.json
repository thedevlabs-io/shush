{
  "name": "block-env-expose",
  "displayName": "Block .env Expose",
  "description": "Hides .env files behind a confirmation gate so they don't flash on screen during calls or screen shares.",
  "version": "0.1.0",
  "publisher": "akhshy",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "env",
    "secrets",
    "privacy",
    "screen share",
    "dotenv"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "blockEnvExpose.redactedEditor",
        "displayName": "Redacted .env",
        "selector": [
          { "filenamePattern": "**/.env" },
          { "filenamePattern": "**/.env.*" },
          { "filenamePattern": "**/*.env" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./ --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
